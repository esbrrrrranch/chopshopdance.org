{
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "oxfmt": "0.78.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "name": "chopshopdance.org",
  "packageManager": "pnpm@12.4.1",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "format": "oxfmt --write \"**/*.{js,html,css}\"",
    "format:check": "oxfmt --check \"**/*.{js,html,css}\"",
    "test": "node --test"
  },
  "type": "module"
}
